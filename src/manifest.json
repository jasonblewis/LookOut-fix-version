{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "lookout-fork@jasonblewis.github.io",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/jasonblewis/LookOut-fix-version/ot/updates.json"
    }
  },
  "version": "7.4.2.5",
  "default_locale": "en-US",
  "author": "Jason Lewis (fork of LookOut by Dugite-Code)",
  "homepage_url": "https://github.com/jasonblewis/LookOut-fix-version",
  "icons": {
    "32": "icons/LOicon-32.png",
    "48": "icons/LOicon-48.png",
    "64": "icons/LOicon-64.png"
  },
  "experiment_apis": {
    "Attachment": {
      "schema": "api/Attachment/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "Attachment"
          ]
        ],
        "script": "api/Attachment/implementation.js"
      }
    },
    "LegacyPrefs": {
      "schema": "api/LegacyPrefs/schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "paths": [
          [
            "LegacyPrefs"
          ]
        ],
        "script": "api/LegacyPrefs/implementation.js"
      }
    }
  },
  "background": {
    "page": "background.html"
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "scripting",
    "storage"
  ],
  "options_ui": {
    "page": "options/options.html"
  }
}
